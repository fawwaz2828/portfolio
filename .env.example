# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (or "Connect" → App Frameworks).
# The anon/publishable key is safe in the frontend. NEVER use the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The live address of the site, for link previews, canonical URL and sitemap.xml
# (not secret; also set it in the hosting provider's environment variables)
SITE_URL=https://your-domain.com
